<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.android-rndis-macos.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/android-rndis-macos</string>
		<string>--watch</string>
		<string>--verbose</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>KeepAlive</key>
	<false/>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>StandardOutPath</key>
	<string>/var/log/android-rndis-macos.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/android-rndis-macos.log</string>
</dict>
</plist>
